# ============================================
# 阶梯导学服务环境配置（样例：复制为 .env 后填入真实值）
# ============================================

PORT=3001

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=islm_platform

# ---------- 大模型（OpenAI 兼容协议，可切换供应商）----------
# ark = 火山方舟豆包（支持 thinking 与 /embeddings）；deepseek = DeepSeek 开放平台；openai = 任意兼容网关
LLM_PROVIDER=ark
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your_api_key
LLM_MODEL=doubao-1-5-pro-32k-250115
# 示例：DeepSeek
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-chat

# true = 本地模拟模式；联调真实大模型时改为 false
LLM_MOCK=true
# MOCK_LEAK=true
# 是否调用远端 embedding 接口（仅 ark 提供；DeepSeek 无此接口，保持 false 走本地伪向量）
# EMBEDDING_REMOTE=false

# ---------- 账号与 AI 分析 ----------
# 注册教师账号所需的邀请码（role=teacher 时必须一致）
TEACHER_INVITE_CODE=HZYJ-TEACHER
# 学生画像 / 学习建议是否调用大模型润色（false = 只用确定性规则模板）
PROFILE_USE_LLM=true
# JWT 签名密钥（生产环境务必改成随机长串）
JWT_SECRET=islm-platform-dev-secret
